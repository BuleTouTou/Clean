{
  "name": "housing-cleaner-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite --host 127.0.0.1",
    "check": "tsc --noEmit",
    "openapi:export": "uv run --no-cache --directory .. --project backend python -m backend.export_openapi --output backend/openapi.json",
    "worma:gen": "bun run openapi:export && worma gen -p .",
    "api:gen": "bun run worma:gen"
  },
  "dependencies": {
    "@tanstack/vue-query": "^5.62.0",
    "alova": "^3.3.0",
    "naive-ui": "^2.41.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "wormajs": "^0.3.0"
  }
}
